# Caching optimieren für bessere Performance
<IfModule mod_expires.c>
    ExpiresActive On
    
    # Bilder: 1 Jahr
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    
    # CSS & JavaScript: 1 Monat
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType text/javascript "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    
    # Fonts: 1 Jahr
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/ttf "access plus 1 year"
    ExpiresByType font/otf "access plus 1 year"
    
    # HTML: 1 Stunde (für Updates)
    ExpiresByType text/html "access plus 1 hour"
</IfModule>

# Compression aktivieren
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>

# Cache-Control Header setzen
<IfModule mod_headers.c>
    # Statische Assets: 1 Jahr Cache
    <FilesMatch "\.(jpg|jpeg|png|gif|webp|svg|ico|woff|woff2|ttf|otf)$">
        Header set Cache-Control "max-age=31536000, public, immutable"
    </FilesMatch>
    
    # CSS & JS: 1 Monat Cache
    <FilesMatch "\.(css|js)$">
        Header set Cache-Control "max-age=2592000, public"
    </FilesMatch>
    
    # HTML: 1 Stunde Cache
    <FilesMatch "\.(html|htm)$">
        Header set Cache-Control "max-age=3600, public, must-revalidate"
    </FilesMatch>
</IfModule>

# --- SEO: kanonische /leistungen/…-URLs (sprechende Pfade) → echte HTML-Dateien + 301 von alten URLs ---
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 301: alte .html-Dateien unter Leistungen/
  RewriteCond %{THE_REQUEST} \s/+Leistungen/social-media\.html[\s?] [NC]
  RewriteRule ^Leistungen/social-media\.html$ /leistungen/social-media-content [R=301,L]
  RewriteCond %{THE_REQUEST} \s/+Leistungen/management\.html[\s?] [NC]
  RewriteRule ^Leistungen/management\.html$ /leistungen/influencer-management [R=301,L]
  RewriteCond %{THE_REQUEST} \s/+Leistungen/smc\.html[\s?] [NC]
  RewriteRule ^Leistungen/smc\.html$ /leistungen/fotoproduktion [R=301,L]
  RewriteCond %{THE_REQUEST} \s/+Leistungen/video\.html[\s?] [NC]
  RewriteRule ^Leistungen/video\.html$ /leistungen/videoproduktion [R=301,L]
  RewriteCond %{THE_REQUEST} \s/+Leistungen/3d-design\.html[\s?] [NC]
  RewriteRule ^Leistungen/3d-design\.html$ /leistungen/3d-visualisierung [R=301,L]
  RewriteCond %{THE_REQUEST} \s/+Leistungen/motion\.html[\s?] [NC]
  RewriteRule ^Leistungen/motion\.html$ /leistungen/motion-graphics [R=301,L]

  # 301: frühere kurze „Pretty-URLs“ → neue sprechende Slugs
  RewriteRule ^leistungen/social-media$ /leistungen/social-media-content [R=301,L,NC]
  RewriteRule ^leistungen/management$ /leistungen/influencer-management [R=301,L,NC]
  RewriteRule ^leistungen/smc$ /leistungen/fotoproduktion [R=301,L,NC]
  RewriteRule ^leistungen/video$ /leistungen/videoproduktion [R=301,L,NC]
  RewriteRule ^leistungen/3d-design$ /leistungen/3d-visualisierung [R=301,L,NC]
  RewriteRule ^leistungen/motion$ /leistungen/motion-graphics [R=301,L,NC]

  # Intern: neue Slugs → vorhandene Dateien (Ordner „Leistungen“)
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Root-Seiten ohne .html (falls jemand die kanonische URL aufruft)
  RewriteRule ^portfolio/?$ portfolio.html [L,NC]
  RewriteRule ^team/?$ team.html [L,NC]
  RewriteRule ^kontakt/?$ kontakt.html [L,NC]
  RewriteRule ^fragebogen/?$ Fragebogen.html [L,NC]
  RewriteRule ^nein/?$ nein.html [L,NC]
  RewriteRule ^impressum/?$ impressum.html [L,NC]
  RewriteRule ^datenschutz/?$ Datenschutz.html [L,NC]

  RewriteRule ^leistungen/social-media-content/?$ Leistungen/social-media.html [L,NC]
  RewriteRule ^leistungen/influencer-management/?$ Leistungen/management.html [L,NC]
  RewriteRule ^leistungen/fotoproduktion/?$ Leistungen/smc.html [L,NC]
  RewriteRule ^leistungen/videoproduktion/?$ Leistungen/video.html [L,NC]
  RewriteRule ^leistungen/3d-visualisierung/?$ Leistungen/3d-design.html [L,NC]
  RewriteRule ^leistungen/motion-graphics/?$ Leistungen/motion.html [L,NC]
</IfModule>
